+//! Camera-paced QR wallpaper transfer and PDDB persistence.
+//!
+//! The browser emits eight independently checksummed 256-byte frames. Frames
+//! may arrive out of order or more than once; PDDB is written only after the
+//! complete 2,048-byte image passes its whole-image CRC-32.
+
+use std::io::Write;
+
+use dc34_api::{DC34_DICT, DC34_IMAGE};
+
+pub const URI_PREFIX: &str = "dc34image://";
+pub const IMAGE_BYTES: usize = 2048;
+pub const FRAME_BYTES: usize = 256;
+pub const FRAME_COUNT: usize = IMAGE_BYTES / FRAME_BYTES;
+pub const BITMAP_WORDS: usize = IMAGE_BYTES / core::mem::size_of::<u32>();
+
+const MAGIC: [u8; 4] = *b"D34I";
+const VERSION: u8 = 1;
+const FLAGS: u8 = 0;
+const HEADER_BYTES: usize = 14;
+const FRAME_CRC_BYTES: usize = 4;
+const RECORD_BYTES: usize = HEADER_BYTES + FRAME_BYTES + FRAME_CRC_BYTES;
+
+#[derive(Copy, Clone, Debug, Eq, PartialEq)]
+pub enum WallpaperQrError {
+    NotWallpaperQr,
+    InvalidBase45,
+    InvalidLength,
+    InvalidMagic,
+    UnsupportedVersion,
+    UnsupportedFlags,
+    InvalidFrame,
+    FrameChecksumMismatch,
+    ImageChecksumMismatch,
+}
+
+impl WallpaperQrError {
+    pub fn user_message(self) -> &'static str {
+        match self {
+            Self::NotWallpaperQr => "Not a BadgeBloom wallpaper QR",
+            Self::InvalidBase45 => "Wallpaper QR has invalid Base45 data",
+            Self::InvalidLength => "Wallpaper QR has the wrong length",
+            Self::InvalidMagic => "Wallpaper QR has an invalid header",
+            Self::UnsupportedVersion => "Wallpaper QR version is not supported",
+            Self::UnsupportedFlags => "Wallpaper QR uses unsupported options",
+            Self::InvalidFrame => "Wallpaper QR has invalid frame metadata",
+            Self::FrameChecksumMismatch => "Wallpaper frame checksum failed",
+            Self::ImageChecksumMismatch => "Complete wallpaper checksum failed",
+        }
+    }
+}
+
+#[derive(Clone, Debug)]
+struct ImageFrame {
+    transfer_id: u32,
+    index: usize,
+    payload: [u8; FRAME_BYTES],
+}
+
+#[derive(Copy, Clone, Debug, Eq, PartialEq)]
+pub enum FrameStatus {
+    Progress { received: usize, total: usize, duplicate: bool },
+    Complete([u32; BITMAP_WORDS]),
+}
+
+pub struct ImageTransfer {
+    transfer_id: Option<u32>,
+    received_mask: u8,
+    received_count: usize,
+    bytes: [u8; IMAGE_BYTES],
+}
+
+impl ImageTransfer {
+    pub fn new() -> Self {
+        Self { transfer_id: None, received_mask: 0, received_count: 0, bytes: [0u8; IMAGE_BYTES] }
+    }
+
+    pub fn reset(&mut self) {
+        self.transfer_id = None;
+        self.received_mask = 0;
+        self.received_count = 0;
+        self.bytes.fill(0);
+    }
+
+    pub fn accept_uri(&mut self, uri: &str) -> Result<FrameStatus, WallpaperQrError> {
+        let frame = decode_frame(uri)?;
+        if self.transfer_id != Some(frame.transfer_id) {
+            self.reset();
+            self.transfer_id = Some(frame.transfer_id);
+        }
+
+        let bit = 1u8 << frame.index;
+        if self.received_mask & bit != 0 {
+            return Ok(FrameStatus::Progress {
+                received: self.received_count,
+                total: FRAME_COUNT,
+                duplicate: true,
+            });
+        }
+
+        let offset = frame.index * FRAME_BYTES;
+        self.bytes[offset..offset + FRAME_BYTES].copy_from_slice(&frame.payload);
+        self.received_mask |= bit;
+        self.received_count += 1;
+
+        if self.received_count != FRAME_COUNT {
+            return Ok(FrameStatus::Progress {
+                received: self.received_count,
+                total: FRAME_COUNT,
+                duplicate: false,
+            });
+        }
+
+        let transfer_id = self.transfer_id.unwrap();
+        if crc32(&self.bytes) != transfer_id {
+            self.reset();
+            return Err(WallpaperQrError::ImageChecksumMismatch);
+        }
+
+        let mut bitmap = [0u32; BITMAP_WORDS];
+        for (word, chunk) in bitmap.iter_mut().zip(self.bytes.chunks_exact(4)) {
+            *word = u32::from_be_bytes(chunk.try_into().unwrap());
+        }
+        self.reset();
+        Ok(FrameStatus::Complete(bitmap))
+    }
+}
+
+pub fn save_wallpaper(bitmap: &[u32; BITMAP_WORDS]) -> bool {
+    let pddb = pddb::Pddb::new();
+    let Ok(mut key) = pddb.get(DC34_DICT, DC34_IMAGE, None, true, true, Some(IMAGE_BYTES), None::<fn()>)
+    else {
+        return false;
+    };
+    if key.write_all(bytemuck::cast_slice(bitmap)).is_err() {
+        return false;
+    }
+    pddb.sync().is_ok()
+}
+
+fn decode_frame(uri: &str) -> Result<ImageFrame, WallpaperQrError> {
+    let encoded = uri.strip_prefix(URI_PREFIX).ok_or(WallpaperQrError::NotWallpaperQr)?;
+    let record = base45::decode(encoded.as_bytes()).map_err(|_| WallpaperQrError::InvalidBase45)?;
+    if record.len() != RECORD_BYTES {
+        return Err(WallpaperQrError::InvalidLength);
+    }
+    if record[..MAGIC.len()] != MAGIC {
+        return Err(WallpaperQrError::InvalidMagic);
+    }
+    if record[4] != VERSION {
+        return Err(WallpaperQrError::UnsupportedVersion);
+    }
+    if record[5] != FLAGS {
+        return Err(WallpaperQrError::UnsupportedFlags);
+    }
+
+    let transfer_id = u32::from_be_bytes(record[6..10].try_into().unwrap());
+    let index = record[10] as usize;
+    let frame_count = record[11] as usize;
+    let payload_len = u16::from_be_bytes(record[12..14].try_into().unwrap()) as usize;
+    if index >= FRAME_COUNT || frame_count != FRAME_COUNT || payload_len != FRAME_BYTES {
+        return Err(WallpaperQrError::InvalidFrame);
+    }
+
+    let crc_offset = record.len() - FRAME_CRC_BYTES;
+    let expected = u32::from_be_bytes(record[crc_offset..].try_into().unwrap());
+    if crc32(&record[..crc_offset]) != expected {
+        return Err(WallpaperQrError::FrameChecksumMismatch);
+    }
+    let mut payload = [0u8; FRAME_BYTES];
+    payload.copy_from_slice(&record[HEADER_BYTES..crc_offset]);
+    Ok(ImageFrame { transfer_id, index, payload })
+}
+
+/// CRC-32/ISO-HDLC: poly 0xedb88320, init/xorout 0xffffffff, reflected.
+fn crc32(bytes: &[u8]) -> u32 {
+    let mut crc = 0xffff_ffffu32;
+    for &byte in bytes {
+        crc ^= byte as u32;
+        for _ in 0..8 {
+            crc = if crc & 1 != 0 { (crc >> 1) ^ 0xedb8_8320 } else { crc >> 1 };
+        }
+    }
+    crc ^ 0xffff_ffff
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn make_frame(image: &[u8; IMAGE_BYTES], index: usize) -> String {
+        let transfer_id = crc32(image);
+        let mut body = Vec::from(MAGIC);
+        body.push(VERSION);
+        body.push(FLAGS);
+        body.extend_from_slice(&transfer_id.to_be_bytes());
+        body.push(index as u8);
+        body.push(FRAME_COUNT as u8);
+        body.extend_from_slice(&(FRAME_BYTES as u16).to_be_bytes());
+        body.extend_from_slice(&image[index * FRAME_BYTES..(index + 1) * FRAME_BYTES]);
+        let frame_crc = crc32(&body);
+        body.extend_from_slice(&frame_crc.to_be_bytes());
+        format!("{}{}", URI_PREFIX, base45::encode(&body))
+    }
+
+    #[test]
+    fn crc_matches_the_standard_vector() {
+        assert_eq!(crc32(b"123456789"), 0xcbf4_3926);
+    }
+
+    #[test]
+    fn accepts_frames_out_of_order_and_ignores_duplicates() {
+        let mut image = [0u8; IMAGE_BYTES];
+        for (index, byte) in image.iter_mut().enumerate() {
+            *byte = (index.wrapping_mul(73).wrapping_add(19) & 0xff) as u8;
+        }
+        let mut transfer = ImageTransfer::new();
+        for index in (0..FRAME_COUNT).rev() {
+            let status = transfer.accept_uri(&make_frame(&image, index)).unwrap();
+            if index == FRAME_COUNT - 1 {
+                assert_eq!(
+                    transfer.accept_uri(&make_frame(&image, index)).unwrap(),
+                    FrameStatus::Progress { received: 1, total: FRAME_COUNT, duplicate: true }
+                );
+            }
+            if index == 0 {
+                let FrameStatus::Complete(bitmap) = status else { panic!("expected complete image") };
+                assert_eq!(bitmap[0], u32::from_be_bytes(image[..4].try_into().unwrap()));
+                assert_eq!(bitmap[BITMAP_WORDS - 1], u32::from_be_bytes(image[IMAGE_BYTES - 4..].try_into().unwrap()));
+            }
+        }
+    }
+
+    #[test]
+    fn matches_the_web_zero_image_vector() {
+        let image = [0u8; IMAGE_BYTES];
+        let frame = decode_frame("dc34image://:").unwrap();
+        assert_eq!(frame.transfer_id, crc32(&image));
+        assert_eq!(frame.index, 0);
+        assert_eq!(frame.payload, [0u8; FRAME_BYTES]);
+    }
+
+    #[test]
+    fn rejects_corrupted_frames() {
+        let image = [0u8; IMAGE_BYTES];
+        let mut uri = make_frame(&image, 0).into_bytes();
+        let payload_character = URI_PREFIX.len() + 120;
+        uri[payload_character] = if uri[payload_character] == b'0' { b'1' } else { b'0' };
+        let corrupted = String::from_utf8(uri).unwrap();
+        assert_eq!(decode_frame(&corrupted).unwrap_err(), WallpaperQrError::FrameChecksumMismatch);
+    }
+}
