@@ -417,3 +417,57 @@ pub fn progress_bar(fb: &mut dyn FrameBuffer, progress: usize) {
     }
     fb.0.draw().ok();
 }
+
+#[cfg(feature = "board-baosec")]
+/// Render a compact early-boot checkpoint below the boot marquee.
+///
+/// Format: `D<phase><event> I<index> P<pid> T<tag>`, where event is
+/// `B` (before), `A` (after), or `S` (phase start), and tag is one of
+/// `F` (IniF), `E` (IniE), `S` (IniS), `K` (kernel), or `O` (other).
+pub fn diagnostic_status(
+    fb: &mut dyn FrameBuffer,
+    phase: u8,
+    event: u8,
+    index: usize,
+    pid: u8,
+    tag: u8,
+) {
+    use ux_api::bitmaps::baochip128x128::MARQUEE_BELOW;
+    use ux_api::minigfx::{ColorNative, DrawStyle, PixelColor, Point, Rectangle};
+
+    fn decimal_2(value: usize) -> [u8; 2] {
+        let value = value.min(99);
+        [b'0' + (value / 10) as u8, b'0' + (value % 10) as u8]
+    }
+
+    let index = decimal_2(index);
+    let pid = decimal_2(pid as usize);
+    let mut text = *b"D0S I00 P00 TO";
+    text[1] = b'0' + phase.min(9);
+    text[2] = event;
+    text[5..7].copy_from_slice(&index);
+    text[9..11].copy_from_slice(&pid);
+    text[13] = tag;
+
+    let mut fb = ux_api::minigfx::DynFb(fb);
+    ux_api::minigfx::op::rectangle(
+        &mut fb,
+        Rectangle::new_with_style(
+            Point::new(0, MARQUEE_BELOW as isize),
+            Point::new(128, 128),
+            DrawStyle::new(PixelColor::Dark, PixelColor::Dark, 1),
+        ),
+        None,
+        false,
+    );
+    // Every byte in `text` is assigned from an ASCII literal or decimal digit.
+    let text = unsafe { core::str::from_utf8_unchecked(&text) };
+    super::gfx::msg(
+        &mut fb,
+        text,
+        Point::new(20, MARQUEE_BELOW as isize + 8),
+        ColorNative::from(PixelColor::Light),
+        ColorNative::from(PixelColor::Dark),
+    );
+    fb.0.draw().ok();
+}
