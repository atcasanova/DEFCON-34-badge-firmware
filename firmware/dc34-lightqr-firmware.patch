+++ b/src/lightqr.rs
@@ -0,0 +1,181 @@
+//! Decoder and persistence for the open, unauthenticated QR format used by DC34 Light Studio.
+//!
+//! This intentionally lives outside the encrypted conference light-exchange
+//! protocol. Custom firmware runs in developer mode, where the provisioned
+//! exchange secret has already been erased.
+
+use std::io::{Read, Write};
+
+use dc34_api::{DC34_DICT, Haploid};
+
+pub const URI_PREFIX: &str = "dc34light://";
+const STORAGE_KEY: &str = "lightstudio.gene";
+const MAGIC: [u8; 4] = *b"DC34";
+const VERSION: u8 = 1;
+const HEADER_LEN: usize = 6;
+const GENE_LEN: usize = core::mem::size_of::<Haploid>();
+const RECORD_LEN: usize = HEADER_LEN + GENE_LEN + 2;
+
+#[derive(Copy, Clone, Debug, Eq, PartialEq)]
+pub enum LightQrError {
+    NotLightQr,
+    InvalidBase45,
+    InvalidLength,
+    InvalidMagic,
+    UnsupportedVersion,
+    UnsupportedFlags,
+    ChecksumMismatch,
+    InvalidPattern,
+}
+
+impl LightQrError {
+    pub fn user_message(self) -> &'static str {
+        match self {
+            Self::NotLightQr => "Not a Light Studio QR code",
+            Self::InvalidBase45 => "Light QR has invalid Base45 data",
+            Self::InvalidLength => "Light QR has the wrong length",
+            Self::InvalidMagic => "Light QR has an invalid header",
+            Self::UnsupportedVersion => "Light QR version is not supported",
+            Self::UnsupportedFlags => "Light QR uses unsupported options",
+            Self::ChecksumMismatch => "Light QR checksum failed",
+            Self::InvalidPattern => "Light QR pattern is out of range",
+        }
+    }
+}
+
+pub fn decode_uri(uri: &str) -> Result<Haploid, LightQrError> {
+    let encoded = uri.strip_prefix(URI_PREFIX).ok_or(LightQrError::NotLightQr)?;
+    let record = base45::decode(encoded.as_bytes()).map_err(|_| LightQrError::InvalidBase45)?;
+
+    if record.len() != RECORD_LEN {
+        return Err(LightQrError::InvalidLength);
+    }
+    if record[..MAGIC.len()] != MAGIC {
+        return Err(LightQrError::InvalidMagic);
+    }
+    if record[4] != VERSION {
+        return Err(LightQrError::UnsupportedVersion);
+    }
+    if record[5] != 0 {
+        return Err(LightQrError::UnsupportedFlags);
+    }
+
+    let checksum_offset = RECORD_LEN - 2;
+    let expected = u16::from_be_bytes(record[checksum_offset..].try_into().unwrap());
+    if crc16_ccitt_false(&record[..checksum_offset]) != expected {
+        return Err(LightQrError::ChecksumMismatch);
+    }
+
+    let pattern = Haploid::deserialize(&record[HEADER_LEN..checksum_offset])
+        .ok_or(LightQrError::InvalidPattern)?;
+    validate_pattern(&pattern)?;
+    Ok(pattern)
+}
+
+pub fn load_pattern() -> Option<Haploid> {
+    let pddb = pddb::Pddb::new();
+    let mut key = pddb
+        .get(DC34_DICT, STORAGE_KEY, None, true, true, Some(GENE_LEN), None::<fn()>)
+        .ok()?;
+    let mut bytes = [0u8; GENE_LEN];
+    key.read_exact(&mut bytes).ok()?;
+    let pattern = Haploid::deserialize(&bytes)?;
+    validate_pattern(&pattern).ok()?;
+    Some(pattern)
+}
+
+pub fn save_pattern(pattern: Haploid) -> bool {
+    let pddb = pddb::Pddb::new();
+    let Ok(mut key) =
+        pddb.get(DC34_DICT, STORAGE_KEY, None, true, true, Some(GENE_LEN), None::<fn()>)
+    else {
+        return false;
+    };
+    if key.write_all(&pattern.serialize()).is_err() {
+        return false;
+    }
+    pddb.sync().is_ok()
+}
+
+fn validate_pattern(pattern: &Haploid) -> Result<(), LightQrError> {
+    let hue_direction = pattern.hue_ratedir >> 4;
+    if pattern.cd_period > 6
+        || pattern.hue_base > pattern.hue_bound
+        || !matches!(hue_direction, 0 | 15)
+        || !matches!(pattern.chaser, 0 | 255)
+        || !matches!(pattern.nonlin, 0 | 255)
+    {
+        return Err(LightQrError::InvalidPattern);
+    }
+    Ok(())
+}
+
+/// CRC-16/CCITT-FALSE: poly 0x1021, init 0xffff, no reflection, xorout 0.
+fn crc16_ccitt_false(bytes: &[u8]) -> u16 {
+    let mut crc = 0xffffu16;
+    for &byte in bytes {
+        crc ^= (byte as u16) << 8;
+        for _ in 0..8 {
+            crc = if crc & 0x8000 != 0 { (crc << 1) ^ 0x1021 } else { crc << 1 };
+        }
+    }
+    crc
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn make_uri(pattern: Haploid) -> String {
+        let mut record = Vec::from(MAGIC);
+        record.push(VERSION);
+        record.push(0);
+        record.extend_from_slice(&pattern.serialize());
+        record.extend_from_slice(&crc16_ccitt_false(&record).to_be_bytes());
+        format!("{}{}", URI_PREFIX, base45::encode(&record))
+    }
+
+    #[test]
+    fn decodes_a_canonical_pattern() {
+        let pattern = Haploid {
+            cd_period: 3,
+            cd_rate: 160,
+            cd_dir: 255,
+            sat: 220,
+            hue_ratedir: 0xf5,
+            hue_base: 12,
+            hue_bound: 180,
+            chaser: 255,
+            nonlin: 255,
+        };
+        assert_eq!(decode_uri(&make_uri(pattern)).unwrap().serialize(), pattern.serialize());
+    }
+
+    #[test]
+    fn rejects_corruption() {
+        let pattern = Haploid {
+            cd_period: 2,
+            hue_bound: 1,
+            chaser: 255,
+            nonlin: 255,
+            ..Default::default()
+        };
+        let mut uri = make_uri(pattern);
+        uri.push('0');
+        assert!(matches!(decode_uri(&uri), Err(LightQrError::InvalidLength)));
+    }
+
+    #[test]
+    fn matches_the_web_encoder_vector() {
+        let pattern = decode_uri("dc34light://FS8DL6V50SK0PFWZ/U%DG EW+3").unwrap();
+        assert_eq!(
+            pattern.serialize(),
+            vec![0x03, 0xa0, 0xff, 0xdc, 0xf5, 0x00, 0x80, 0xff, 0xff]
+        );
+    }
+
+    #[test]
+    fn ignores_unrelated_qr_codes() {
+        assert_eq!(decode_uri("otpauth://totp/example"), Err(LightQrError::NotLightQr));
+    }
+}
