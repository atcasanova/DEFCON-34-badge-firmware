+    /// 0xRRGGBB colors. Settings are behavior | rate_25ms << 8 | brightness << 16.
+    pub fn configure_eyes(&mut self, left_rgb: u32, right_rgb: u32, settings: u32) {
+        self.send_control(0x0400_0000 | (left_rgb & 0x00ff_ffff));
+        self.send_control(0x0500_0000 | (right_rgb & 0x00ff_ffff));
+        self.send_control(0x0600_0000 | (settings & 0x00ff_ffff));
+    }
