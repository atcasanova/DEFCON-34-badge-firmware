             result_objects.append(obj)
             continue
 
+        # Each split becomes an independent `.word`-packed object below. A
+        # non-word-aligned alias would therefore gain up to three padding bytes
+        # and move every object after it, while the compiled instructions keep
+        # using the original packed offsets. Refuse to generate corrupt BIO
+        # code; callers should group byte fields into one explicit struct.
+        unaligned_splits = [off for off, _ in splits if off % 4 != 0]
+        if unaligned_splits:
+            offsets = ", ".join(str(off) for off in unaligned_splits)
+            raise ValueError(
+                f"unaligned .set aliases in {obj.name} at byte offsets {offsets}; "
+                "group byte-sized globals into a single struct"
+            )
+
